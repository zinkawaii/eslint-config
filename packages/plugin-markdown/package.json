{
  "name": "@zinkawaii/eslint-plugin-markdown",
  "type": "module",
  "version": "8.0.3-patch.0",
  "description": "Utakata na Shiawase",
  "author": "KazariEX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zinkawaii/eslint-config.git",
    "directory": "packages/plugin-markdown"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node vendor/tools/build-rules.js && tsdown",
    "dev:prepare": "git submodule update --init && pnpm run vendor:apply-patch",
    "prepack": "pnpm run build",
    "release": "zin release",
    "test": "vitest",
    "vendor:generate-patch": "git -C vendor diff > patches/@eslint__markdown.patch",
    "vendor:apply-patch": "git -C vendor apply --3way ../patches/@eslint__markdown.patch"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "dependencies": {
    "@eslint/core": "catalog:",
    "@eslint/plugin-kit": "catalog:",
    "@types/mdast": "catalog:",
    "github-slugger": "catalog:",
    "micromark-util-normalize-identifier": "catalog:",
    "satorigear": "catalog:"
  }
}
