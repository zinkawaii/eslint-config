{
  "name": "@zinkawaii/eslint-config-css",
  "type": "module",
  "version": "0.5.2",
  "description": "Utakata na Shiawase",
  "author": "KazariEX",
  "license": "MIT",
  "repository": "zinkawaii/eslint-config",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown -w",
    "prepack": "pnpm run build",
    "prepare": "pnpm run typegen",
    "test": "vitest",
    "typegen": "unrun scripts/typegen.ts"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "dependencies": {
    "@eslint/css": "catalog:",
    "eslint-flat-config-utils": "catalog:",
    "eslint-plugin-css-properties-order": "catalog:",
    "eslint-plugin-css-stylistic": "catalog:"
  },
  "devDependencies": {
    "@zinkawaii/eslint-config": "workspace:",
    "eslint-typegen": "catalog:",
    "known-css-properties": "catalog:"
  }
}
